# BreatheSafe Campus — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# Data mode: "live" for real CPCB/OpenAQ data, "demo" for labelled fixtures
DATA_MODE=demo

# CPCB API key (from data.gov.in — optional, only needed for live mode)
CPCB_API_KEY=

# AWS region
AWS_REGION=ap-south-1

# Frontend API URL (filled after SAM deploy)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEFAULT_CAMPUS=dtu-delhi
