# Copy to .env.local and adjust.
# API Gateway URL of your deployed stack (output "ApiUrl" of `sam deploy`).
# If unset, the app uses the project's public demo API.
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com/prod

# Cognito user pool / app client of the same stack (outputs "UserPoolId" and
# "UserPoolClientId"). Public identifiers; set them together with the API URL.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
