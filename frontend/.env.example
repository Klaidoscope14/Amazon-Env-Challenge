# Copy to .env.local and fill in from your stack's outputs:
#   aws cloudformation describe-stacks --stack-name <stack> --query "Stacks[0].Outputs"
# All three are required; the build stops if one is missing.

# API Gateway URL (output "ApiUrl"). Leave empty only when the site is served
# by the stack's own CloudFront distribution (same-origin /api).
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com/prod

# Cognito user pool / app client (outputs "UserPoolId" and "UserPoolClientId").
# Public identifiers, not secrets.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
