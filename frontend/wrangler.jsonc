// Cloudflare Workers static-assets config: serves the Next.js static export
// (out/) from Cloudflare's edge. Used by `npx wrangler deploy` (Workers Builds).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breathesafe",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./out",
    // /about -> about.html, and unknown paths get out/404.html with a 404 status.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
