{
  // Type-checking only; SAM bundles each Lambda with esbuild (see infrastructure/template.yaml).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node", "aws-lambda"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["shared/src/**/*.ts", "services/*/src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
